<Window x:Class="KqlPad.Views.QueryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="940" Height="800" MinWidth="720" MinHeight="620"
        Style="{StaticResource ConsoleWindow}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CATEGORY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CategoryBox" IsEditable="True" Margin="0,0,0,8"
                      ToolTip="Pick an existing category or type a new one"/>
            <TextBlock Grid.Row="1" Text="NAME" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Text="DESCRIPTION" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="DescriptionBox" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Text="TAGS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TagsBox" Margin="0,0,0,8" ToolTip="Comma separated"/>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,8,0,6">
            <Button DockPanel.Dock="Right" Content="DETECT FROM KQL" Click="Detect_Click" Style="{StaticResource GhostButton}" Margin="0"
                    ToolTip="Add a parameter row for every {{token}} found in the KQL"/>
            <TextBlock Text="// PARAMETERS   use {{name}} in the KQL" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="ParamGrid" ItemsSource="{Binding Params}" AutoGenerateColumns="False"
                  CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="130"/>
                <DataGridTextColumn Header="LABEL" Binding="{Binding Label}" Width="170"/>
                <DataGridTextColumn Header="DEFAULT / SAMPLE VALUE" Binding="{Binding Default}" Width="210"/>
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                <DataGridCheckBoxColumn Header="RAW" Binding="{Binding Raw}" Width="56"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,12,0,6" Style="{StaticResource SectionLabel}" Text="// KQL"/>
        <TextBox Grid.Row="4" x:Name="KqlBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontSize="13" Padding="12,10"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="SAVE" MinWidth="90" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="CANCEL" MinWidth="90" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
