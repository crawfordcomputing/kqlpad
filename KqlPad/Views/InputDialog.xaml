<Window x:Class="KqlPad.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource ConsoleWindow}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
        <TextBox x:Name="Input"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
            <Button Content="CANCEL" IsCancel="True" MinWidth="80" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
