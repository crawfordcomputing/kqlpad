<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>KqlPad</RootNamespace>
    <AssemblyName>KqlPad</AssemblyName>
    <Version>0.1.0</Version>
    <!-- Fluent / system dark-light theming is still flagged experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Starter query library, copied to %APPDATA%\KqlPad\queries on first run -->
    <EmbeddedResource Include="Starter\*.json" />
  </ItemGroup>

</Project>
